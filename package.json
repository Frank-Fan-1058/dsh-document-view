{
  "name": "dsh-document-view",
  "version": "1.2.4",
  "description": "Split document view for DeepSeek Harness: the document stays centered while the chat stays on the right. Strike out or comment on Word / PDF / PPT pages, send the review to the AI, and see each edit highlighted.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "icon.svg",
    "locale/*.json",
    "docs",
    "src",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "bundle",
    "document",
    "document-view",
    "split-view",
    "layout",
    "ui",
    "office",
    "productivity",
    "annotation",
    "annotations",
    "review",
    "pdf",
    "docx",
    "split-screen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Frank-Fan-1058/dsh-document-view.git"
  },
  "bugs": {
    "url": "https://github.com/Frank-Fan-1058/dsh-document-view/issues"
  },
  "homepage": "https://github.com/Frank-Fan-1058/dsh-document-view#readme",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    }
  }
}
